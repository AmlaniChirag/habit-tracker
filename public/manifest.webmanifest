{
  "name": "Habit Tracker",
  "short_name": "Habits",
  "description": "A minimalist habit tracker — build streaks, stay consistent.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "categories": ["productivity", "lifestyle", "health"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's habits",
      "short_name": "Today",
      "description": "Check off today's habits",
      "url": "/?shortcut=today",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Add habit",
      "short_name": "Add",
      "description": "Create a new habit",
      "url": "/?shortcut=add",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
